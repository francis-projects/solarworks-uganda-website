{
  "name": "solarworks-uganda-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "cf:types": "wrangler types --include-runtime=false",
    "check": "npm run build && npm run typecheck:worker && npm run test",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy:preview": "wrangler pages deploy dist --branch=preview",
    "cf:deploy:production": "wrangler pages deploy dist --branch=main"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^26.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
